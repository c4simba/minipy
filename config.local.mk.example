# Machine-local build overrides (copy to config.local.mk, which is git-ignored).
# Only set what differs from the Makefile defaults.

# KolibriOS cross-toolchain root (contains sdk/bin/i586-kolibrios-gcc):
# KOS32_PREFIX  = /path/to/kolibrios/toolchain

# newlib libc dir (must contain crt/pseudo-reloc.o):
# KOS_SDK_LIBDIR = /path/to/kolibrios-sdk/libraries/newlib/libc

# Compiler for the Linux i386 runtime of compiled programs (make rt-linux):
# RT_LINUX_CC = gcc -m32

# Where the KolibriOS runtime image and fasm live on KolibriOS (used by the
# KolibriOS minipy for --compile):
# KOS_AOT_RT   = /sys/lib/minipy-rt.bin
# KOS_AOT_FASM = /sys/develop/fasm
