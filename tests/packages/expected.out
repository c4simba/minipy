--- pyproject.toml
[project]
name = "proj"
version = "0.1.0"
requires-python = ">=3.14"
dependencies = [
    "okpkg",
    "mixpkg",
    "unionpkg",
    "untypedpkg",
]
--- pylock.toml (names, versions, check)
requirements = ["okpkg", "mixpkg", "unionpkg", "untypedpkg"]
name = "mixpkg"
version = "2.0"
name = "mixpkg-2.0-py3-none-any.whl"
check = "partial"
modules-ok = ["mixpkg"]
name = "okpkg"
version = "1.2"
name = "okpkg-1.2-py3-none-any.whl"
check = "ok"
modules-ok = ["okpkg", "okpkg.shapes"]
name = "unionpkg"
version = "1.0"
name = "unionpkg-1.0-py3-none-any.whl"
check = "fail"
modules-ok = []
name = "untypedpkg"
version = "1.0"
name = "untypedpkg-1.0-py3-none-any.whl"
check = "fail"
modules-ok = []
