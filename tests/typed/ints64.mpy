# int is 64 bits in compiled code and in the interpreter (CPython's results
# while they fit; OverflowError beyond, see ints_overflow.mpy)
import math
big = 2 ** 40
print(big, big * 1000, -big, big // 3, big % 7, 2 ** 62, -(2 ** 62) * 2)
print(9223372036854775807, -9223372036854775807 - 1, 4294967296 + 1, 0xFFFFFFFF + 1)
a = 123456789012
b = -98765
print(a + b, a - b, a * b, a // b, a % b, -a // b, -a % b, divmod(a, b), divmod(-a, 7))
print(7 // -2, -7 // 2, 7 % -2, -7 % 2, divmod(-7, 2), abs(-a), abs(b))
print(1 << 40, (1 << 62) >> 3, -1 >> 10, -(1 << 50) >> 49, 5 >> 100, a & 0xFFFF, a | 1, a ^ a, ~a)
print(pow(3, 39), pow(3, 200, 1000000007), pow(-5, 3, 7), pow(3, -1, 7), pow(2, 10, -7), pow(123456789, 987654321, 2 ** 61 - 1))
print(math.gcd(2 ** 40, 6 ** 20), math.gcd(-12, 18), math.isqrt(10 ** 18), math.isqrt(2 ** 62 - 1), math.isqrt(99))
print(int("1234567890123456789"), int("-9223372036854775808"), int(" 1_000_000 "), int(2.5e15), int(-7.9), round(2.5e12), round(-3.5))
print(float(2 ** 53 + 1), float(-(2 ** 62)), 2 ** 40 / 3, big > 1.5, big < 1e100, big == 2.0 ** 40)
print(hex(big), oct(big), bin(big), hex(-255), f"{big:,}", f"{-a:_}", f"{a:>20}|{a:<20}|{a:^20}", f"{255:#x} {255:#o} {5:#b} {-5:08d}")
print("%d %x %o %5d|%-6d|%+d" % (a, 255, 8, 42, 7, 3), str(a), repr(-a), len(str(9223372036854775807)))
xs = [big, -1, 3, a, b, 0]
print(sorted(xs), min(xs), max(xs), sum(xs), sum([2 ** 61, 2 ** 61, 2 ** 61 - 1]))
d = {big: "big", a: "a", -1: "minus one"}
print(d[big], d[-1], big in d, 2 ** 41 in d, d)
s = {2 ** 61 - 1, 2 ** 61, 2 ** 62, -(2 ** 61), 1, 2, 3, 2 ** 40, -1, -2}
print(s, sorted(s))
print({(big, 1), (1, big)}, {9223372036854775807: 1, -9223372036854775807 - 1: 2})
t = (big, a)
print(t, t < (big, a + 1), hash(1) == 1)
total = 0
for i in range(2 ** 33, 2 ** 33 + 5):
    total += i
print(total, list(range(2 ** 40, 2 ** 40 + 3)), list(range(10, -5, -4)), list(range(-(2 ** 35), -(2 ** 35) + 10, 3)))
for i, x in enumerate(["a", "b"], 2 ** 40):
    print(i, x)
n = 1
for k in range(1, 21):
    n *= k
print(n, n // 2 ** 30, n % 1000000007)
fib = [0, 1]
while len(fib) < 90:
    fib.append(fib[-1] + fib[-2])
print(fib[-1], fib[-1] % 10 ** 9, fib[50:53])
print(2 ** 62 + (2 ** 62 - 1), -(2 ** 62) - 2 ** 62, 3037000499 * 3037000499, -3037000499 * 3037000499)
