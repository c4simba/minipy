# examples/kolibri.mpy against the emulator's fake KolibriOS (tests/x86run.py):
# what the wrappers pass in registers and structures ("[kos]"/"[gui]" lines,
# logged by the fake kernel) and how they decode the answers (the prints)
import sys
import lib.kolibri as k   # a copy of examples/kolibri.mpy

def show(label: str, value: str) -> None:
    print(label + ": " + value)

# ---- time, screen, system
show("event", str(k.wait_event()))     # the mouse (a.events), left of and above the window
show("mouse", str(k.mouse_window_pos()) + " " + str(k.mouse_buttons()) + " " + str(k.mouse_events() & k.MOUSE_LEFT_PRESSED != 0) + " " + str(k.mouse_scroll()) + " " + str(k.mouse_scroll()))
show("time", str(k.system_time()))
show("date", str(k.system_date()))
show("screen", str(k.screen_size()))
show("work area", str(k.screen_work_area()))
show("skin", str(k.skin_height()) + " " + str(k.skin_margins()))
show("video", str(k.video_resolution()) + " " + str(k.video_bits_per_pixel()) + " bpp, " + str(k.video_bytes_per_line()))
ns = k.uptime_ns()
show("uptime", str(ns) + " " + str(int(k.uptime_seconds() * 1000)) + " ms")
show("cpu", str(int(k.cpu_frequency() / 1000000.0)) + " MHz")
show("ram", str(k.free_ram_kb()) + " of " + str(k.total_ram_kb()) + " KB")
ram = k.ram_info()
show("ram info", str([ram.total_pages, ram.free_pages, ram.page_faults, ram.kernel_heap, ram.max_alloc_block]))
v = k.kernel_version()
show("kernel", str(v) + " abi " + str(v.abi_major) + "." + str(v.abi_minor) + " commit " + k.hex32(v.commit) + " +" + str(v.commits_since_release))
c = k.system_colors()
show("colors", str([c.frame, c.grab, c.work, c.graph]))
show("languages", str(k.keyboard_language()) + " " + str(k.system_language()))
layout = k.keyboard_layout(k.LAYOUT_SHIFT)
show("layout", str(sys.peek(layout, 0, 1)) + " " + str(sys.peek(layout, 127, 1)))
show("msr", str(k.read_msr(0x10)))
show("access", str(k.hd_access_enabled()) + " " + str(k.pci_access_enabled()) + " " + str(k.cache_enabled()))
k.set_system_time(23, 59, 7)
k.set_system_date(2027, 1, 31)
k.set_window_zpos(k.ZPOS_ALWAYS_TOP)
k.set_screen_work_area(0, 0, 1023, 700)
k.set_mouse_pos(512, 384)
k.write_msr(0x1B, 0x12345678, 0x9)

# ---- processes
me = k.thread_info()
show("me", me.name + " pid " + str(me.pid) + " slot " + str(k.current_slot()) + " of " + str(k.max_slot()))
names: list[str] = []
for t in k.threads():
    names.append(t.name + "/" + str(t.pid))
show("threads", str(names))
show("slot of 4300", str(k.slot_of_pid(4300)) + ", of 999: " + str(k.slot_of_pid(999)))
show("priority", str(k.thread_priority()) + " -> " + str(k.set_thread_priority(1)))
show("kill", str(k.kill_pid(4300)) + " " + str(k.kill_pid(31337)))

# ---- mouse and keyboard
show("mouse", str(k.mouse_screen_pos()) + " " + str(k.mouse_window_pos()) + " " + str(k.mouse_buttons()))
show("mouse speed", str(k.mouse_speed()) + " delay " + str(k.double_click_delay()))
cur = k.load_cursor_file("/sys/arrow.cur")
show("cursor", str(cur) + " " + str(k.set_cursor(cur)) + " " + str(k.set_cursor(0)))
k.delete_cursor(cur)
k.set_keyboard_mode(k.KEYMODE_SCANCODES)
show("keyboard", str(k.keyboard_mode()) + " mods " + str(k.control_keys() == k.MOD_NUMLOCK))
k.set_keyboard_mode(k.KEYMODE_ASCII)
show("hotkey", str(k.set_hotkey(0x2E, 0x110)))

# ---- drawing (logged by the fake desktop)
k.define_window_ex(10, 20, 300, 200, k.WS_SKINNED | k.WS_CAPTION, 0xFFFFFF, "API", 0x112233)
k.put_pixel(1, 2, 0xFF0000)
k.draw_line(0, 0, 50, 25, 0x00FF00)
k.draw_number(5, 6, 255, 4, 0x000000, base=16, leading_zeros=True)
k.draw_number(5, 26, -12, 6, 0x000000)
k.draw_text_ex(7, 8, "big", 0x0000FF, font=k.FONT_8X16, scale=2, background=0xEEEEEE)
canvas = k.new_canvas(64, 16)
k.draw_text_canvas(canvas, 0, 0, "in a canvas", 0x123456, font=k.FONT_UTF8)
img = sys.buffer(4 * 2 * 3)
sys.poke(img, 0, 0x332211, 4)
k.draw_image(img, 40, 50, 4, 2)
pal = sys.buffer(8)
sys.poke(pal, 0, 0x000000, 4)
sys.poke(pal, 4, 0xFFFFFF, 4)
bits = sys.buffer(16)
sys.poke(bits, 0, 0xA5, 1)
k.draw_image_palette(bits, 60, 70, 8, 2, 1, pal, 3)
bmp = sys.buffer(16 * 4)
sys.poke(bmp, 0, 0x44332211, 4)
k.blit(bmp, 1, 2, 4, 4, 0, 0, 4, 4, 16)
k.move_window(-1, 50)
k.set_title_utf8("Заголовок")
k.remove_title()
shape = sys.buffer(16)
sys.poke(shape, 0, 0x01010101, 4)
k.set_window_shape(shape)
k.reset_window_shape()
show("pixel", str(k.screen_pixel(3, 2)) + " owner " + str(k.pixel_owner(3, 2)))
area = k.read_screen(0, 0, 2, 1)
show("screen area", str([sys.peek(area, 0, 1), sys.peek(area, 5, 1)]))
show("background", str(k.background_size()) + " mode " + str(k.background_mode()) + " last " + str(k.background_last_redraw()))
rect = k.background_read_rect(7, 0, 2, 1)
show("background rect", str(sys.peek(rect, 0, 4)) + " " + str(sys.peek(rect, 4, 4)))
k.background_redraw_rect(1, 2, 3, 4)
show("font", str(k.font_smoothing()) + " " + str(k.font_size()) + " skin " + str(k.set_skin("/sys/default.skn")))

# ---- files on the RAM disk (/tmp0/1)
root = "/tmp0/1"
listing: list[str] = []
for e in k.list_folder(root):
    listing.append(e.name + ("/" if e.is_folder() else "=" + str(e.size)))
show("ls", str(listing))
show("dot entries", str(len(k.list_folder(root + "/docs"))))
show("read", repr(k.read_file(root + "/hello.txt", 5)))
show("read all", repr(k.read_text(root + "/docs/readme.txt")))
show("missing", str(k.read_file(root + "/nope", 10) is None) + " " + str(k.file_size(root + "/nope")))
show("write", str(k.write_file(root + "/new.txt", "first")) + " " + str(k.append_file(root + "/new.txt", "+second")))
show("new", repr(k.read_text(root + "/new.txt")) + " " + str(k.file_size(root + "/new.txt")))
show("write at", str(k.write_at(root + "/new.txt", 0, "FIRST")) + " " + repr(k.read_text(root + "/new.txt")))
show("truncate", str(k.set_file_size(root + "/new.txt", 3)) + " " + repr(k.read_text(root + "/new.txt")))
info = k.file_info(root + "/new.txt")
show("info", str(info.attributes) + " " + str(info.size) + " " + str(info.modified))
k.set_attributes(root + "/new.txt", k.ATTR_READONLY | k.ATTR_ARCHIVE)
show("attrs", str(k.file_info(root + "/new.txt").attributes))
show("mkdir", str(k.make_folder(root + "/made")) + " " + str(k.file_info(root + "/made").is_folder()))
show("rename", str(k.rename_file(root + "/new.txt", "renamed.txt")) + " " + str(k.file_exists(root + "/renamed.txt")) + " " + str(k.file_exists(root + "/new.txt")))
show("unicode", str(k.write_file(root + "/файл.txt", "данные")) + " " + repr(k.read_text(root + "/файл.txt")))
show("symlink", str(k.make_symlink(root + "/link", "/tmp0/1/hello.txt")) + " " + repr(k.read_symlink(root + "/link")))
show("delete", str(k.delete_file(root + "/made")) + " " + str(k.delete_file(root + "/docs")) + " " + str(k.delete_file(root + "/link")))
buf = sys.buffer(8)
show("read into", str(k.read_into(root + "/kernel.mnt", 254, buf, 8)) + " " + str([sys.peek(buf, 0, 1), sys.peek(buf, 1, 1), sys.peek(buf, 2, 1)]))
show("run", str(k.run_program(root + "/hello.txt", "-v")) + " " + str(k.run_program(root + "/nothing")))
show("load file", repr(k.load_file(root + "/docs/notes.txt")))
k.set_current_folder("/tmp0/1/docs")
show("cwd", k.current_folder())
k.add_system_folder("home", "/hd0/1/home")

# ---- clipboard, IPC, debug board, pipes, futexes
show("clipboard", str(k.clipboard_count()) + " " + repr(k.clipboard_get_text(0)))
k.clipboard_put_text("copied text")
show("clipboard", str(k.clipboard_count()) + " " + repr(k.clipboard_get_text()))
show("clipboard delete", str(k.clipboard_delete_last()) + " " + str(k.clipboard_count()))
ipc = k.ipc_area(64)
k.set_ipc_area(ipc)
show("ipc send", str(k.ipc_send(k.current_pid(), "ping")) + " " + str(k.ipc_send(k.current_pid(), "pong!")) + " " + str(k.ipc_send(77, "x")))
show("ipc full", str(k.ipc_send(k.current_pid(), "a long message that does not fit")))
show("event", str(k.check_event()))
show("ipc receive", str(k.ipc_receive(ipc)) + " " + str(k.ipc_receive(ipc)))
k.debug_write("dbg\n")
show("board", str([k.debug_read(), k.debug_read(), k.debug_read(), k.debug_read(), k.debug_read()]))
p = k.pipe()
show("pipe", str(p) + " " + str(k.pipe_write(p[1], "through the pipe")) + " " + repr(k.pipe_read_str(p[0], 7)) + " " + repr(k.pipe_read_str(p[0], 100)))
f = k.futex_create(5)
show("futex", str(f) + " " + str(k.futex_wait(f, 4)) + " " + str(k.futex_wait(f, 5, 10)) + " " + str(k.futex_destroy(f)))

# ---- memory, drivers, shared memory
heap = k.heap_init()
block = k.mem_alloc(100)
sys.poke_at(block, 1234567, 4)
bigger = k.mem_realloc(block, 10000)
show("memory", str(heap > 0) + " " + str(sys.peek_at(bigger, 4)) + " " + str(k.mem_free(bigger)))
shm = k.shm_open("my-area", 4096, k.SHM_CREATE | k.SHM_WRITE)
sys.poke_str_at(shm[0], "shared")
again = k.shm_open("my-area", 0, k.SHM_OPEN)
show("shm", str(shm[1]) + " " + str(again[1]) + " " + sys.cstr_at(again[0], 64) + " " + str(k.shm_open("other", 0, k.SHM_OPEN)))
k.shm_close("my-area")
drv = k.load_driver("SOUND")
inp = sys.buffer(3)
sys.poke(inp, 0, 0x0201, 2)
sys.poke(inp, 2, 3, 1)
out = sys.buffer(3)
show("driver", str(drv) + " " + str(k.load_driver("NONE")) + " " + str(k.control_driver(drv, 7, inp, 3, out, 3)) + " " + str(sys.peek(out, 0, 1)))
dnames: list[str] = []
for dr in k.drivers():
    dnames.append(dr.name)
show("drivers", str(dnames))
show("signal", str(k.wait_signal()))

# ---- PCI, network, sockets
show("pci", str(k.pci_version()) + " " + str(k.pci_last_bus()) + " " + str(k.pci_read(0, 1, 0, 0, 2)) + " " + str(k.pci_read(0, 1, 0, 2, 2)) + " " + str(k.pci_read(0, 1, 0, 0, 4) & 0xFFFFFFFF) + " " + str(k.pci_read(0, 2, 0, 0, 2)))
k.pci_write(0, 1, 0, 0x3C, 1, 11)
show("net devices", str(k.net_device_count()) + " " + str(k.net_device_name(1)) + " " + str(k.net_device_name(5) is None) + " link " + str(k.net_link_status(1)))
show("net bytes", str(k.net_bytes_sent(1)) + " packets " + str(k.net_packets_sent(1)))
show("mac", k.mac_to_str(k.mac_address(1)))
show("ip", k.ip_to_str(k.ip_address()) + " dns " + k.ip_to_str(k.dns_address()) + " mask " + k.ip_to_str(k.subnet_mask()) + " gw " + k.ip_to_str(k.gateway()))
k.set_ip_address(k.ip_from_str("10.1.2.3"))
arp = k.arp_entry(0)
show("arp", str(k.arp_count()) + " " + k.ip_to_str(arp.ip) + " " + k.mac_to_str(arp.mac) + " ttl " + str(arp.ttl) + " " + str(k.arp_entry(1) is None))
k.arp_add(k.ip_from_str("192.168.0.77"), [1, 2, 3, 4, 5, 6], 60)
s = k.socket_open(k.AF_INET4, k.SOCK_STREAM, k.IPPROTO_TCP)
show("socket", str(s) + " " + str(k.socket_connect(s[0], k.sockaddr_in("93.184.216.34", 80))))
show("send", str(k.socket_send(s[0], "GET / HTTP/1.0\r\n\r\n")))
show("receive", repr(k.socket_receive_str(s[0], 64)))
peer = sys.buffer(16)
show("accept", str(k.socket_accept(s[0], peer)) + " " + k.sockaddr_ip(peer) + ":" + str(k.sockaddr_port(peer)))
show("option", str(k.socket_get_option(s[0], 1, 2)) + " " + str(k.socket_set_option(s[0], 1, 2, 3)))
show("close", str(k.socket_close(s[0])) + " pair " + str(k.socket_pair()))

# ---- debugging
regs = k.debug_get_registers(77)
show("debug regs", str(regs[0]) + " " + str(regs[6]))
mem = sys.buffer(4)
show("debug read", str(k.debug_read_memory(77, 0x1000, mem, 4)) + " " + str(sys.peek(mem, 3, 1)))
k.debug_set_breakpoint(77, 1, 0x2000, 3, 3)
k.speaker_play(sys.buffer(4))
k.send_message(k.EV_KEY, 65)
