# FastAPI's README example and more, served by lib/uvicorn.mpy (C library
# sockets through ctypes) to the scripted clients of fastapi_linux.requests
# (tests/x86run.py's fake C library). The answers are real FastAPI's.
import asyncio
from typing import Union

from fastapi import FastAPI, HTTPException

app = FastAPI()


@app.get("/")
def read_root():
    return {"Hello": "World"}


@app.get("/items/{item_id}")
def read_item(item_id: int, q: Union[str, None] = None):
    return {"item_id": item_id, "q": q}


class Item:
    def __init__(self, name: str, price: float, tags: list[str]):
        self.name = name
        self.price = price
        self.tags = tags


ITEMS = {"foo": Item("Foo", 50.2, ["tool"]), "bar": Item("Bar", 62.0, [])}


@app.get("/catalog/{name}")
async def catalog(name: str, discount: float = 0.0, verbose: bool = False):
    await asyncio.sleep(0)
    if name not in ITEMS:
        raise HTTPException(status_code=404, detail="Item not found")
    item = ITEMS[name]
    tags: list[str] = []
    if verbose:
        tags = item.tags
    return {"item": item.name, "price": item.price * (1 - discount), "tags": tags}


@app.get("/objects/{name}")
def as_object(name: str):
    return ITEMS[name]


@app.post("/echo")
def echo(text: str, times: int = 1):
    return [text for _ in range(times)]


@app.get("/users/{user_id}/items/{item_name}")
def user_item(user_id: int, item_name: str, short: bool = True):
    description: Union[str, None] = None
    if not short:
        description = "a long description"
    return {"user": user_id, "item": item_name, "description": description}


@app.get("/boom")
def boom():
    raise ValueError("a bug in the endpoint")


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="127.0.0.1", port=8000)
